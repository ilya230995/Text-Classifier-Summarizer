# Copy to .env and fill in. Never commit .env.

# Free key (no card needed): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini | keyword  (keyword runs fully offline, no key needed)
PROVIDER=gemini

# Leave empty to use the built-in default model
GEMINI_MODEL=

# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
